# btle_mvp_pico2ice.pcf  --  pin assignment for btle_mvp_pico2ice (wrapper around btle_mvp_top)
#
# Board: pico2-ice (iCE40UP5K-SG48) -> SN65LVDS049 -> ATREB215-XPRO (AT86RF215, I/Q mode, 2.4 GHz)
# Pin numbers are SG48 package pins (= the ICE_nn net number on the pico2-ice schematic).
# Wiring and the reasons behind each choice: hw/radio_interface_pinout.md (same pins as hw/radio_if.pcf).
#
# All signals below are on 3.3 V banks: J2 Bank 0 PMOD (fixed 3.3 V) and J2 Bank 2 PMOD
# (VIO_BANK_2 = 3.3 V while SJ5 is closed).  The SN65LVDS049 needs >= 2 V driver-input highs and its
# receiver outputs swing to 3.3 V, so a bank below 3.3 V would break the link.

# --- clocks
set_io clk_local   35     # ICE_35_G0 <- RP2350 GPIO21 CLK_GPOUT0, 12 MHz (radio_cli fpga_init)
set_io rxclk_in    44     # J2-31 ICE_44_G6 <- SN65LVDS049 ROUT1 (pin 15) <- RXCLK, 64 MHz DDR

# --- I/Q link through the SN65LVDS049 (J2 Bank 2 PMOD, 3.3 V with SJ5 closed)
set_io rxd_in      46     # J2-29 <- ROUT2 (pin 14) <- RXDP24/N
set_io txclk_out   48     # J2-27 -> DIN1  (pin 10) -> TXCLKP/N
set_io txd_out     47     # J2-28 -> DIN2  (pin 11) -> TXDP/N

# --- radio SPI / control to ATREB215-XPRO J100 (J2 Bank 0 PMOD, 3.3 V)
set_io rf_sclk     28     # J2-9  -> J100-18 SPI_SCK
set_io rf_mosi     32     # J2-11 -> J100-16 SPI_MOSI
set_io -pullup yes rf_miso 36   # J2-13 <- J100-17 SPI_MISO (radio tri-states MISO while SELN is high)
set_io rf_seln     42     # J2-15 -> J100-15 SPI_SS_A (active low)
set_io rf_irq      31     # J2-10 <- J100-9  IRQ (active high, RF_CFG.IRQP = 0)
set_io rf_rstn     34     # J2-12 -> J100-7  RESET (active low); only matters if that wire is fitted

# --- debug outputs on the free 3.3 V pins (all active high, push-pull)
#   Probe with a scope / logic analyser, or drive an LED through ~330 ohm to GND.
#   uart_txd: 115200 8N1, received packets.  Connect to a 3.3 V USB-serial adapter's RX + GND.
set_io led_ready   38     # J2-14  radio configured, RX/TX loop running
set_io led_fault   43     # J2-16  a check failed (part number, state poll, TX timeout); auto-retries
set_io uart_txd    45     # J2-30  packet dump, 115200 8N1
set_io led_rx_ok   2      # J2-32  stretched pulse: packet with good CRC received
set_io led_tx      3      # J2-33  stretched pulse: packet transmitted
set_io dbg_rx_lock 4      # J2-34  LVDS RX word framing locked (RXD24 decoding); high whenever the radio is in RX
